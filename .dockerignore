# .dockerignore
#
# The build context is what the daemon uploads before the first Dockerfile
# instruction runs, so everything excluded here is upload time and cache
# invalidation saved on every build.
#
# public/fonts must remain in the build context. Vite copies it into dist/, and
# the licensed webfonts are part of the shipped UI.

# Dependencies are installed inside the builder stage from the lockfile; a host
# node_modules tree is the wrong platform and the wrong lifecycle.
node_modules
**/node_modules

# Build output and logs are produced in the image or are machine-local.
dist
build
logs
coverage

# Version control and editor state.
.git
.gitignore
.github
.idea
.vscode
.DS_Store
Thumbs.db
desktop.ini

# .env* is gitignored because it carries real credentials. It must never be
# baked into a layer either — compose and the orchestrator inject env at run
# time. `.env.example` is documentation, so excluding it costs nothing.
.env
.env.*
*.pem

# The source workbook generates src/db/seed_excel.sql via
# scripts/regenerate_catalog_seed.py. The generated SQL is already in the
# context, so the workbook is regenerator input that the image never reads.
data/source/NEXG_Nairobi_Merchant_Seed_Catalog.xlsx

# Impeccable workflow scratch: screenshots, harnesses and detector payloads.
# Machine-local working state, not project source (.gitignore excludes it too).
.impeccable
logs/critique

# Another tool's working directory, unrelated to this app.
.img2threejs-mascot

# Local npm cache created because the global cache path is outside the sandbox.
.npm-cache

# Test and screenshot artefacts.
test-results
playwright-report
