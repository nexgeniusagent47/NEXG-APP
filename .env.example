# NEXG Concierge — environment
#
# Copy to `.env` and fill in. Three variables are read by the running application.
#
#   DATABASE_URL  Postgres connection string. When set AND reachable, Postgres is the
#                 source of truth and /api/health reports "source": "postgres".
#                 When unset or unreachable, the API falls back to the bundled JSON
#                 seed and reports "source": "seeded_json_fallback" — the app still
#                 runs with a smaller catalogue, which is what makes a cold deploy
#                 possible before a database exists.
#
#   AUTH_SECRET   Signs session JWTs. At least 32 characters. NO DEFAULT — the server
#                 refuses to start without it, on purpose: a fallback value would mean
#                 every deployment that forgot to set one shares a signing key, so
#                 anyone could mint valid tokens for it. See docs/AUTH.md.
#
#   PORT          Port the API — and the built SPA it serves — listens on.
#                 Defaults to 3001.
#
# The previous version of this file documented GEMINI_API_KEY and APP_URL. Neither is
# referenced anywhere in src/, server/ or scripts/, so they were removed rather than
# left to mislead: anyone setting them was configuring nothing.

# ------------------------------------------------------------------ local default
# Matches the container started by `npm run db:up` (Postgres 15 on port 5433).
DATABASE_URL=postgresql://nexg_user:nexg_password@127.0.0.1:5433/nexg_db

# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# ------------------------------------------------------------------- production
# Managed Postgres usually requires TLS. Append the provider's parameter, e.g.
#   DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# Most providers inject DATABASE_URL themselves, in which case set nothing here.

PORT=3001
